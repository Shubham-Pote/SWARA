{
  "name": "language-learning-backend",
  "version": "1.0.0",
  "description": "Backend for language learning application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:api": "npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "test": "node --require tsx/cjs --test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.12",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "language-learning",
    "spanish",
    "japanese",
    "education"
  ],
  "license": "MIT",
  "private": true
}
