# Required for sign-in and authenticated requests.
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=

# Local defaults. Set an explicit MongoDB URI in hosted environments.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/language-learning

# Required for AI conversation and new generated content. Keep server-side.
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=

# Optional voice. Set the key and the voice ID for each language you enable.
ELEVENLABS_API_KEY=
ELEVENLABS_MARIA_VOICE_ID=
ELEVENLABS_AKIRA_VOICE_ID=

# Extra origins as a comma-separated list for separately hosted clients.
# CORS_ORIGIN=https://your-client.example
# MAX_CONVERSATIONS_PER_HOUR=100
